<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>LSUIElement</key>
  <true/>
  <key>NSLocalNetworkUsageDescription</key>
  <string>kitedrop sends files, text and links to your other devices on this network.</string>
  <!-- kitedrop://send?… from the share extension (desktop/macos-share, decisions D39). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.mucahitimre.kitedrop</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>kitedrop</string>
      </array>
    </dict>
  </array>
  <key>NSBonjourServices</key>
  <array>
    <string>_kitedrop._tcp</string>
  </array>
</dict>
</plist>
