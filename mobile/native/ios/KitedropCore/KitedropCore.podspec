# Pure-native pod: the Rust core (static xcframework) plus its UniFFI Swift bindings.
# No React Native / Expo dependency, so the share extension can link it without a JS runtime.
# Contents are generated by scripts/build-mobile-core.sh ios.
Pod::Spec.new do |s|
  s.name             = 'KitedropCore'
  s.version          = '0.1.0'
  s.summary          = 'kitedrop Rust core with Swift bindings'
  s.homepage         = 'https://github.com/mucahitimre/kitedrop'
  s.license          = { :type => 'MIT' }
  s.author           = 'kitedrop'
  s.source           = { :path => '.' }
  s.platforms        = { :ios => '16.4' }
  s.swift_version    = '5.9'
  s.source_files     = 'Sources/**/*.swift'
  s.vendored_frameworks = 'KitedropFFI.xcframework'
  # UniFFI-generated Swift is application-extension safe; required for the share extension.
  s.pod_target_xcconfig = { 'APPLICATION_EXTENSION_API_ONLY' => 'YES' }
end
